universe = vanilla
executable = htcondor_wrapper_e0c831e839_9.sh
should_transfer_files = YES
transfer_input_files = /afs/cern.ch/work/z/zhibin/snd-ml/law/htcondor_output/jobs/tmph54l3oc6/law_job_1d8cc5c1f3.sh,/afs/cern.ch/work/z/zhibin/snd-ml/law/htcondor_output/jobs/tmph54l3oc6/htcondor_wrapper_e0c831e839_9.sh,/afs/cern.ch/work/z/zhibin/snd-ml/law/htcondor_output/jobs/tmph54l3oc6/bootstrap_a419881e3f.sh
transfer_output_files = stdall$(law_job_postfix).txt

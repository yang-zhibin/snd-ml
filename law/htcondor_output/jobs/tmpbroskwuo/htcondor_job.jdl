universe = vanilla
executable = htcondor_wrapper_e0c831e839_1.sh
should_transfer_files = YES
transfer_input_files = /afs/cern.ch/work/z/zhibin/snd-ml/law/htcondor_output/jobs/tmpbroskwuo/law_job_1d8cc5c1f3.sh,/afs/cern.ch/work/z/zhibin/snd-ml/law/htcondor_output/jobs/tmpbroskwuo/htcondor_wrapper_e0c831e839_1.sh,/afs/cern.ch/work/z/zhibin/snd-ml/law/htcondor_output/jobs/tmpbroskwuo/bootstrap_a419881e3f.sh
transfer_output_files = stdall$(law_job_postfix).txt
when_to_transfer_output = ON_EXIT
transfer_output_remaps = "stdall$(law_job_postfix).txt = /afs/cern.ch/user/z/zhibin/work/snd-ml/law/HTCondor_submission/stdall$(law_job_postfix).txt"
notification = Never
initialdir = /afs/cern.ch/user/z/zhibin/work/snd-ml/law/HTCondor_submission
MY.WantOS = el9
+MaxRuntime = 3599
getenv = true
log = /afs/cern.ch/work/z/zhibin/snd-ml/law/htcondor_output
environment = "LAW_HTCONDOR_JOB_CLUSTER=$(Cluster) LAW_HTCONDOR_JOB_PROCESS=$(Process)"
queue law_job_postfix, arguments from (
    _0To1, _0To1 stdall$(law_job_postfix).txt
    _1To2, _1To2 stdall$(law_job_postfix).txt
    _2To3, _2To3 stdall$(law_job_postfix).txt
    _3To4, _3To4 stdall$(law_job_postfix).txt
)

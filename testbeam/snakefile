rule process_newDigi:
    input:
        #expand("/afs/cern.ch/work/z/zhibin/snd-ml/snakemake/metadata/updated/{metadata_csv}", metadata_csv=metadata_csv_list),
        newRaw=lambda wildcards: get_metadata_value("newDigi_path", wildcards.newDigi_path, "raw_path"),
        geo=lambda wildcards: get_metadata_value("newDigi_path", wildcards.newDigi_path, "geo_path"),
        #run_digi_wrapper = "/afs/cern.ch/user/z/zhibin/work/snd-ml/check_MCEventbuilder/run_digi_wrapper.sh"
    params:
        env_file = "/afs/cern.ch/user/z/zhibin/work/snd-ml/snakemake/envs/env_sndsw.sh",
        
    output:
        newDigi_path="{newDigi_path}"
    threads:2
    resources:
        runtime=23*60*60,
        mem_mb=8000,
        disk_mb=8000,
        nvidia_gpu=0
    shell:
        r"""
        # Avoid conda/python conflicts from the Snakemake env
        export PATH=$(echo "$PATH" | tr ':' '\n' | grep -v 'miniconda3' | tr '\n' ':' | sed 's/:$//')

        set +u  # Avoid unbound variable errors

        echo "Setting up SNDSW environment"
        export ALIBUILD_WORK_DIR=/afs/cern.ch/work/z/zhibin/public/SndBuild/sw
        # Use a single, consistent stack (Jan30); avoid mixing 2024 Python with 2025 libs
        source /cvmfs/sndlhc.cern.ch/SNDLHC-2025/Jan30/setUp.sh
        eval "$(alienv load sndsw/latest-24d197c57d-release --no-refresh)"
        export EOSSHIP=root://eosuser.cern.ch/

        # Work in a scratch dir and ensure cleanup
        tmp_dir="$(mktemp -d)"
        trap 'status=$?; echo "Cleaning up"; rm -rf "${{tmp_dir}}"; exit $status' EXIT
        echo "tmp_dir: ${{tmp_dir}}"
        cd "${{tmp_dir}}"

        # Localize input
        filename="$(basename "{input.newRaw}")"
        echo "Fetching: {input.newRaw} -> ${{filename}}"
        xrdcp -f "{input.newRaw}"  "${{filename}}"
        ls -al
        # Expected output name (bash subst). Keep this in sync with run_digiSND output naming.
        tmp_output="${{filename/.root/_dig.root}}"
        echo "Will look for output: ${{tmp_output}}"
        echo "Geometry: {input.geo}"

        echo "Processing newDigi file"
        set +e
        python $SNDSW_ROOT/shipLHC/run_digiSND.py \
        -f "${{filename}}" \
        -g {input.geo} \
        #-d True

        rc=$?
        set -e
        echo "[run_digiSND.py] exit code: ${{rc}}"
        test "${{rc}}" -eq 143 || {{ echo "run_digiSND.py failed"; exit "${{rc}}";}}

        # Resolve the produced file robustly:
        if [[ -f "${{tmp_output}}" ]]; then
        produced="${{tmp_output}}"
        else
        # Fallback: grab the first *_dig.root in CWD
        produced="$(ls -1 *_dig.root 2>/dev/null | head -n1 || true)"
        [[ -n "${{produced}}" ]] || {{ echo "ERROR: No *_dig.root produced"; ls -al; exit 1; }}
        echo "Detected output: ${{produced}}"
        fi

        echo "Transferring output to EOS: {output.newDigi_path}"
        xrdcp -f "${{produced}}" "{output.newDigi_path}" || {{ echo "xrdcp failed"; exit 1; }}

        # Additional explicit cleanup (trap also removes tmp_dir)
        rm -f "${{produced}}" "${{filename}}"


        """


rule process_hits:
    input:
        #expand("{work_dir}/snd-ml/testbeam/metadata/updated/{metadata_csv}", metadata_csv=metadata_csv_list, work_dir=personal_work_dir),
        digi=lambda wildcards: get_metadata_value("hit_path", wildcards.hit_path, "digi_path"),
        geo=lambda wildcards: get_metadata_value("hit_path", wildcards.hit_path, "geo_path"),
        # preSelect=lambda wildcards: get_metadata_value("hit_path", wildcards.hit_path, "preSelect_path"),
        script = f"{personal_work_dir}/snd-ml/testbeam/Converted_data/digi_2_hits_testbeam.py",
        
        
    params:
        data_type=lambda wildcards: get_metadata_value("hit_path", wildcards.hit_path, "data_type"),
        pdg=lambda wildcards: get_metadata_value("hit_path", wildcards.hit_path, "beam_type"),
        env_file = f"{personal_work_dir}/snd-ml/testbeam/env/env_sndsw.sh",
        sndsw_dir = personal_sndsw_dir,
        work_dir = personal_work_dir
    output:
        hit_path="{hit_path}"
    threads:1
    resources:
        runtime=1*60*60,
        mem_mb=2000,
        disk_mb=2000,
        nvidia_gpu=0
    shell:
        r"""
        # Avoid conda/python conflicts
        export PATH=$(echo $PATH | tr ':' '\n' | grep -v 'miniconda3' | tr '\n' ':' | sed 's/:$//')
        set +u  # Avoid unbound variable errors

        # Set up environment
        echo "Setting up SNDSW"
        export SNDLHC_mymaster="{params.sndsw_dir}"
        echo $SNDLHC_mymaster
        export ALIBUILD_WORK_DIR=$SNDLHC_mymaster/sw
        source /cvmfs/sndlhc.cern.ch/SNDLHC-2025/Jan30/setUp.sh
        eval $(alienv load sndsw/latest-master-release --no-refresh)
        
        export EOSSHIP=root://eosuser.cern.ch/

        tmp_dir=$(mktemp -d)
        filename=$(basename "{output.hit_path}")
        tmp_output="${{tmp_dir}}/${{filename}}"

        echo "Running digi_2_hits.py"
        /cvmfs/sndlhc.cern.ch/SNDLHC-2024/June25/bin/python \
            {input.script} \
            -d {input.digi} \
            -g {input.geo} \
            -o "${{tmp_output}}" \
            -t {params.data_type} \
            -pdg "{params.pdg}" \
            -w "{params.work_dir}"

        echo "Transferring output to EOS"
        xrdcp -f "${{tmp_output}}" "{output.hit_path}" || {{ echo "xrdcp failed"; exit 1; }}
        echo "Cleaning up"
        rm -rf "${{tmp_dir}}"
        """



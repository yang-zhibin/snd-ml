rule plot_distribution:
    input:
        script=f"{personal_work_dir}/snd-ml/testbeam/evaluation/plot_distributions_withGNN.py"
    output:
        # one flag file per histogram name (wildcard)
        touch("{work_dir}/snd-ml/testbeam/evaluation/plots/{cut_name}/{process_models}/{hist_name}/hist.done")
    params:
        dest_dir="{work_dir}/snd-ml/testbeam/evaluation/plots/{cut_name}/{process_models}/{hist_name}",
        model_name = "{process_models}",
        split = train_split,
    threads: 1
    resources:
        runtime=7*60*60,
        mem_mb=2000,
        disk_mb=2000,
        nvidia_gpu=0
    shell:
        r"""
        echo "running plot_distribution for {wildcards.hist_name} ({wildcards.cut_name})"

        set +u

        source /cvmfs/sft.cern.ch/lcg/views/setupViews.sh LCG_107 x86_64-el9-gcc11-opt

        python {input.script} -n {wildcards.hist_name} -c {wildcards.cut_name} -m {params.model_name} -s {params.split}

        rm -rf {params.dest_dir}
        mkdir -p {params.dest_dir}
        xrdcp ./plots_tmp/{wildcards.cut_name}/{params.model_name}/{wildcards.hist_name}/* {params.dest_dir}/
        rm -r ./plots_tmp/{wildcards.cut_name}/{params.model_name}/{wildcards.hist_name}/
        """
        

def load_metadata():
    if train_mode:
        metadata_prefix = f"{personal_work_dir}/snd-ml/testbeam/metadata/training/{train_split}"
        metadata_files = glob.glob(f"{metadata_prefix}*.csv")
        if not metadata_files:
            print(f"Warning: No CSV files found with prefix {metadata_prefix}")
            return None
        df = pd.concat((pd.read_csv(file) for file in metadata_files), ignore_index=True)
        return df

    else:
        metadata_rootpath = f"{personal_work_dir}/snd-ml/testbeam/metadata/updated/"
        metadata_files = [os.path.join(metadata_rootpath, file_name) for file_name in metadata_csv_list]
        metadata_files = [file for file in metadata_files if os.path.isfile(file)]
        if not metadata_files:  
            print("Warning: No metadata files found.")
            return None
        elif len(metadata_files) == 1:  
            return pd.read_csv(metadata_files[0])
        else:
            df = pd.concat((pd.read_csv(file) for file in metadata_files), ignore_index=True)
            return df
METADATA = load_metadata()
# print(METADATA)


def get_metadata_from_output(ref_name, ref_value, target_name):
    """
    ref_name: one of "model", "eval", or "matrix"
    """
    file_name = os.path.basename(ref_value)
    pattern = rf"{ref_name}_(.+?)_output"
    match = re.search(pattern, file_name)
    if match:
        m_name = match.group(1)
        new_ref_name = f"{ref_name}_{m_name}_output_path"
        
        if (ref_name in {"eval", "matrix"}) and target_name == "model_output":
            target_name = f"prediction_{m_name}_output_path"
        elif ref_name == "matrix" and target_name == "eval_output":
            target_name = f"eval_{m_name}_output_path"


        return get_metadata_value(new_ref_name, ref_value, target_name)
    else:
        print("Pattern not found.")

def get_metadata_value(ref_name, ref_value, target_name):
    # print((ref_name, ref_value, target_name))
    if METADATA is None:
       return ''


    return METADATA.loc[METADATA[ref_name] == ref_value, target_name].iloc[0]

def collect_target_paths(target_name):
    if METADATA is None:
       return ''
    else:
        target_paths = METADATA[target_name].tolist()

    #print(target_paths)
    return target_paths


def collect_model_path(target_name):
    with open("/afs/cern.ch/work/z/zhibin/snd-ml/snakemake/metadata/model_config.yaml", "r") as file:
        model_config = yaml.safe_load(file)
    

    model_name_list = []
    model_ckpt_list = []

    for model in model_config:
        for model_name, items in model.items():
            #print(model_name, paths)
            if (model_name not in process_model):
                continue
            model_name_list.append(model_name)
            ckpt = None
            for item in items:
                if 'ckpt' in item:
                    ckpt = item['ckpt']
                    break
            model_ckpt_list.append(ckpt)

    if target_name=='ckpt':
        return model_ckpt_list
    elif target_name == 'model_output':
        target_paths = []
        for m in model_name_list:
            paths = collect_target_paths(f"prediction_{m}_output_path")
            target_paths.extend(paths)
        #print(target_paths)
        return target_paths
    elif target_name == 'eval_output':
        target_paths = []
        for m in model_name_list:
            paths = collect_target_paths(f"eval_{m}_output_path")
            target_paths.extend(paths)
        return target_paths
    elif target_name == 'matrix_output':
        target_paths = []
        for m in model_name_list:
            paths = collect_target_paths(f"matrix_{m}_output_path")
            target_paths.extend(paths)
        return target_paths


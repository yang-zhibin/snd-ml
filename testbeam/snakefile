rule process_hits:
    input:
        expand("{work_dir}/snd-ml/testbeam/metadata/updated/{metadata_csv}", metadata_csv=metadata_csv_list, work_dir=personal_work_dir),
        digi=lambda wildcards: get_metadata_value("hit_path", wildcards.hit_path, "digi_path"),
        geo=lambda wildcards: get_metadata_value("hit_path", wildcards.hit_path, "geo_path"),
        # preSelect=lambda wildcards: get_metadata_value("hit_path", wildcards.hit_path, "preSelect_path"),
        
        
    params:
        script = f"{personal_work_dir}/snd-ml/testbeam/Converted_data/digi_2_hits_testbeam.py",
        data_type=lambda wildcards: get_metadata_value("hit_path", wildcards.hit_path, "data_type"),
        pdg=lambda wildcards: get_metadata_value("hit_path", wildcards.hit_path, "beam_type"),
        env_file = f"{personal_work_dir}/snd-ml/testbeam/env/env_sndsw.sh",
        sndsw_dir = personal_sndsw_dir,
        work_dir = personal_work_dir
    output:
        hit_path="{hit_path}"
    threads:1
    resources:
        runtime=8*60*60,
        mem_mb=2000,
        disk_mb=2000,
        nvidia_gpu=0
    shell:
        r"""
        # Avoid conda/python conflicts
        export PATH=$(echo $PATH | tr ':' '\n' | grep -v 'miniconda3' | tr '\n' ':' | sed 's/:$//')
        set +u  # Avoid unbound variable errors

        # Set up environment
        echo "Setting up SNDSW"
        export SNDLHC_mymaster="{params.sndsw_dir}"
        echo $SNDLHC_mymaster
        export ALIBUILD_WORK_DIR=$SNDLHC_mymaster/sw
        source /cvmfs/sndlhc.cern.ch/SNDLHC-2025/Jan30/setUp.sh
        eval $(alienv load sndsw/latest-master-release --no-refresh)
        
        export EOSSHIP=root://eosuser.cern.ch/

        tmp_dir=$(mktemp -d)
        filename=$(basename "{output.hit_path}")
        tmp_output="${{tmp_dir}}/${{filename}}"

        echo "Running digi_2_hits.py"
        /cvmfs/sndlhc.cern.ch/SNDLHC-2024/June25/bin/python \
            {params.script} \
            -d {input.digi} \
            -g {input.geo} \
            -o "${{tmp_output}}" \
            -t {params.data_type} \
            -pdg "{params.pdg}" \
            -w "{params.work_dir}"

        echo "Transferring output to EOS"
        xrdcp -f "${{tmp_output}}" "{output.hit_path}" || {{ echo "xrdcp failed"; exit 1; }}
        echo "Cleaning up"
        rm -rf "${{tmp_dir}}"
        """


rule process_features:
    input:
        #expand("{work_dir}/snd-ml/testbeam/metadata/updated/{metadata_csv}", metadata_csv=metadata_csv_list, work_dir=personal_work_dir),
        digi=lambda wildcards: get_metadata_value("feature_path", wildcards.feature_path, "digi_path"),
        geo=lambda wildcards: get_metadata_value("feature_path", wildcards.feature_path, "geo_path"),
        script = f"{personal_work_dir}/snd-ml/testbeam/Converted_data/digi_2_features_testbeam.py"
        
    params:
        data_type=lambda wildcards: get_metadata_value("feature_path", wildcards.feature_path, "data_type"),
        pdg=lambda wildcards: get_metadata_value("feature_path", wildcards.feature_path, "beam_type"),
        env_file = f"{personal_work_dir}/snd-ml/testbeam/env/env_sndsw.sh",
        sndsw_dir = personal_sndsw_dir,
        work_dir = personal_work_dir
    output:
        feature_path="{feature_path}"
    threads:1
    resources:
        runtime=8*60*60,
        mem_mb=2000,
        disk_mb=2000,
        nvidia_gpu=0
    shell:
        r"""
        # Avoid sndsw and conda python conflict 
        export PATH=$(echo $PATH | tr ':' '\n' | grep -v 'miniconda3' | tr '\n' ':' | sed 's/:$//')
        
        # Avoid unbound variable error (only occurs when using Snakemake)
        set +u 
        
        # Set up environment
        echo "Setting up SNDSW"
        echo "Setting up SNDSW"
        export SNDLHC_mymaster="{params.sndsw_dir}"
        echo $SNDLHC_mymaster
        export ALIBUILD_WORK_DIR=$SNDLHC_mymaster/sw
        source /cvmfs/sndlhc.cern.ch/SNDLHC-2025/Jan30/setUp.sh
        eval $(alienv load sndsw/latest-master-release --no-refresh)
        
        export EOSSHIP=root://eosuser.cern.ch/

        # Create a unique temporary directory
        tmp_dir=$(mktemp -d)
        filename=$(basename "{output.feature_path}")
        tmp_output="${{tmp_dir}}/${{filename}}"

        echo "Running feature generation script"
        /cvmfs/sndlhc.cern.ch/SNDLHC-2024/June25/bin/python \
            {input.script} \
            -d {input.digi} \
            -g {input.geo} \
            -o "${{tmp_output}}" \
            -t {params.data_type} \
            -pdg "{params.pdg}"

        echo "Copying result to final location"
        xrdcp -f "${{tmp_output}}" "{output.feature_path}" || {{ echo "xrdcp failed"; exit 1; }}

        echo "Cleaning up"
        rm -rf "${{tmp_dir}}"
        """
        
        
rule process_pt_hit:
    input:
        script = f"{personal_work_dir}/snd-ml/testbeam/Converted_data/root_2_pt_testbeam.py",
        #expand("/afs/cern.ch/work/z/zhibin/snd-ml/snakemake/metadata/updated/{metadata_csv}", metadata_csv=metadata_csv_list),

        #feature_path=lambda wildcards: get_metadata_value("pt_hit_path", wildcards.pt_hit_path, "feature_path"),
        hit_path=lambda wildcards: get_metadata_value("pt_hit_path", wildcards.pt_hit_path, "hit_path"),
        
        #expand("{feature_path}", feature_path=collect_target_paths("feature_path")),
        #expand("{hit_path}", hit_path=collect_target_paths("hit_path")),

    #params:
        
        #data_type=lambda wildcards: get_metadata_value("feature_path", wildcards.feature_path, "data_type"),
        #env_file = "/afs/cern.ch/user/z/zhibin/work/snd-ml/snakemake/envs/env_sndsw.sh"
        #pt_prefix = "{pt_prefix}"
    output:
        pt_hit_path="{pt_hit_path}"
    threads:1
    resources:
        runtime=120*60,
        mem_mb=2000,
        disk_mb=2000,
        nvidia_gpu=0
    shell:
        r"""
        echo "processing root to pt"

        # Avoid unbound variable error (only occurs when using Snakemake)
        set +u 

        # Set up LCG environment
        source /cvmfs/sft.cern.ch/lcg/views/setupViews.sh LCG_107 x86_64-el9-gcc11-opt

        export EOSSHIP=root://eosuser.cern.ch/
        # Create a unique temporary directory
        tmp_dir=$(mktemp -d)
        filename=$(basename "{output.pt_hit_path}")
        tmp_output="${{tmp_dir}}/${{filename}}"

        # Run the processing script
        python {input.script} \
            -hit {input.hit_path} \
            -o "${{tmp_output}}"

        # Copy result to final output path
        xrdcp -f "${{tmp_output}}" "{output.pt_hit_path}" || {{ echo "xrdcp failed"; exit 1; }}

        # Cleanup
        rm -rf "${{tmp_dir}}"
        """
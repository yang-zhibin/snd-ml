#lambda wildcards: print(wildcards.data_type)

def get_metadata_value(ref_name, ref_value, target_name):
    metadata_files = glob.glob(os.path.join(metadata_rootpath, "*_metadata.csv"))
    for file in metadata_files:
        metadata = pd.read_csv(file)
        if ref_value in metadata[ref_name].values:
            return metadata.loc[metadata[ref_name] == ref_value, target_name].iloc[0]
    raise ValueError(f"Reference value {ref_value} not found in column {ref_name} in any metadata file.")

rule process_hits:
    input:
        #expand("/afs/cern.ch/work/z/zhibin/snd-ml/snakemake/metadata/updated/{metadata_csv}", metadata_csv=metadata_csv_list),
        digi=lambda wildcards: get_metadata_value("hit_path", wildcards.hit_path, "digi_path"),
        geo=lambda wildcards: get_metadata_value("hit_path", wildcards.hit_path, "geo_path"),
        script = "/afs/cern.ch/user/z/zhibin/work/snd-ml/convertData/digi_2_hits.py"
    params:
        data_type=lambda wildcards: get_metadata_value("hit_path", wildcards.hit_path, "data_type"),
        env_file = "/afs/cern.ch/user/z/zhibin/work/snd-ml/snakemake/envs/env_sndsw.sh"
    output:
        hit_path="{hit_path}"
    threads:1
    resources:
        runtime=60*60,
        mem_mb=2000,
        disk_mb=2000,
        nvidia_gpu=0
    shell:
        """
        #avoid sndsw and conda python conflict 
        export PATH=$(echo $PATH | tr ':' '\n' | grep -v 'miniconda3' | tr '\n' ':' | sed 's/:$//')
        
        #avoid unbound variable error (only occur when using snakemake)
        set +u 
        
        echo "Setting up SNDSW"
        SNDLHC_mymaster=/afs/cern.ch/work/z/zhibin/public/SndBuild
        export ALIBUILD_WORK_DIR=$SNDLHC_mymaster/sw
        source /cvmfs/sndlhc.cern.ch/SNDLHC-2024/June25/setUp.sh
        eval `alienv load --no-refresh sndsw/latest`

        export EOSSHIP=root://eosuser.cern.ch/

        #cp /afs/cern.ch/user/z/zhibin/work/snd-ml/convertData/EventClass.h ./
        /cvmfs/sndlhc.cern.ch/SNDLHC-2024/June25/bin/python {input.script} -d {input.digi} -g {input.geo} -o {output.hit_path} -t {params.data_type}
        """


rule prediction_3d:
    input:
        #expand("/afs/cern.ch/work/z/zhibin/snd-ml/snakemake/metadata/updated/{metadata_csv}", metadata_csv=metadata_csv_list),
        #expand("{feature_path}", feature_path=collect_target_paths("feature_path")),
        #expand("{hit_path}", hit_path=collect_target_paths("hit_path")),
        #hit_path=lambda wildcards: get_metadata_value("pt_prefix", wildcards.pt_prefix, "hit_path"),
        #expand("{model_ckpt}", model_ckpt=collect_model_path('ckpt')),
        pkl_hit_path=lambda wildcards: get_metadata_from_output("model", wildcards.model_3d_output, "pkl_hit_path"),
        script = '/afs/cern.ch/work/z/zhibin/snd-ml/training_3d/pred_3d.py',
    output:
        pred_output = "{model_3d_output}",

    threads:1
    resources:
        runtime=120*60,
        mem_mb=4000,
        disk_mb=4000,
        nvidia_gpu=0
    shell:
        r"""
        echo "running prediction"

        # Avoid unbound variable error (only occurs when using Snakemake)
        set +u 

        # Set up environment
        source /cvmfs/sft.cern.ch/lcg/views/setupViews.sh LCG_107_cuda x86_64-el9-gcc11-opt
        export EOSSHIP=root://eosuser.cern.ch/
        # Create a unique temporary directory
        tmp_dir=$(mktemp -d)
        tmp_dir_dataloader=$(mktemp -d)
        filename=$(basename "{output.pred_output}")
        tmp_output="${{tmp_dir}}/${{filename}}"

        # Run prediction script
        python {input.script} \
            -i {input.pkl_hit_path} \
            -o "${{tmp_output}}" \
            -t "${{tmp_dir_dataloader}}"

        # Copy result to final destination
        xrdcp -f "${{tmp_output}}" "{output.pred_output}" || {{ echo "xrdcp failed"; exit 1; }}

        # Cleanup
        rm -rf "${{tmp_dir}}"
        """


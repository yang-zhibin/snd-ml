metadata_rootpath = "/afs/cern.ch/work/z/zhibin/snd-ml/snakemake/metadata/updated/"


def collect_target_paths(column_name):
    # Collect paths after metadata is generated
    metadata_files = glob.glob(os.path.join(metadata_rootpath, "MC_neutrino*_metadata.csv"))
    target_paths = []
    for file in metadata_files:
        metadata = pd.read_csv(file)
        target_paths.extend(metadata[column_name].tolist())
    return target_paths



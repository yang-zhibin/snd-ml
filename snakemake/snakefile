    "neutron": hist_names + ["secondary_pdg"],
    "kaon": hist_names + ["secondary_pdg"],
    "data": hist_names,
}
compare_reference_secondary_pairs = [
    (reference, muondis_secondary)
    for reference in compare_references
    for muondis_secondary in compare_muondis_secondaries_by_reference[reference]
]
compare_hist_names = sorted(
    set(
        hist_name
        for reference in compare_references
        for hist_name in compare_hist_names_by_reference[reference]
    )
)
compare_hadron_muondis_pattern = (
    f"{PERSONAL_WORK_SPACE}/evaluation/nueAnalysis/hist/"
    "compare_hadron_muondis__{reference}__{muondis_secondary}__{base_cut_key}__{extra_cut_key}/"
    "{hist_name}__{base_cut_key}__{extra_cut_key}.done"
)
compare_hadron_muondis_targets = [
    target
    for reference, muondis_secondary in compare_reference_secondary_pairs
    for target in expand(
        compare_hadron_muondis_pattern,
        reference=[reference],
        muondis_secondary=[muondis_secondary],
        hist_name=compare_hist_names_by_reference[reference],
        base_cut_key=base_cut_map.keys(),
        extra_cut_key=extra_cut_map.keys(),
    )
]


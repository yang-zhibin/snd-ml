HIST_NAMES = [
    "signed_slope_x", "signed_slope_y", "sum_hit_density", "count_scifi",
    "count_us1", "start_centroid_x", "start_centroid_y", "centroid_slope_y",
    "centroid_slope_x", "start_avgPos_x", "start_avgPos_y", "avgPos_slope_x",
    "avgPos_slope_y",
]
HIST_2d_NAMES = [
    "start_avgPos",
    "avg_scifi", "avg_scifi1", "avg_scifi2", "avg_scifi3", "avg_scifi4", "avg_scifi5",
    "avg_ds", "avg_ds1", "avg_ds2", "avg_ds3",
    "start_centroid",
    "centroid_scifi", "centroid_scifi1", "centroid_scifi2", "centroid_scifi3", "centroid_scifi4", "centroid_scifi5",
    "centroid_ds", "centroid_ds1", "centroid_ds2", "centroid_ds3",
    "centroid_slope", "avgPos_slope", "signed_slope",
]

CUT_STATES = ["cut", "nocut"]

# Build all hist flags for both cut states
rule plots:
    input:
        expand(
            "/afs/cern.ch/user/z/zhibin/work/snd-ml/evaluation/compare_pred_MC/htcondor_plots/plot_flags/{cut}/hist.{hist_name}.done",
            hist_name=HIST_NAMES,
            cut=CUT_STATES,
        ),
        expand(
            "/afs/cern.ch/user/z/zhibin/work/snd-ml/evaluation/compare_pred_MC/htcondor_2d_plots/plot_flags/{cut}/hist.{hist_name}.done",
            hist_name=HIST_2d_NAMES,
            cut=CUT_STATES,
        )

rule plot_distribution:
    input:
        script="/afs/cern.ch/user/z/zhibin/work/snd-ml/evaluation/compare_pred_MC/plot_distribution.py"
    output:
        # one flag file per histogram name *and* cut state
        flag=touch("/afs/cern.ch/user/z/zhibin/work/snd-ml/evaluation/compare_pred_MC/htcondor_plots/plot_flags/{cut}/hist.{hist_name}.done")
    params:
        # separate destinations for cut/nocut
        dest_dir=lambda wc: f"/afs/cern.ch/user/z/zhibin/work/snd-ml/evaluation/compare_pred_MC/htcondor_plots/{wc.cut}",
        # if your script expects a boolean value for -c instead of a bare flag, use the next line instead:
        # cut_arg=lambda wc: ("-c True" if wc.cut == "cut" else "-c False")
    threads: 1
    resources:
        runtime=12*60*60,
        mem_mb=8000,
        disk_mb=4000,
        nvidia_gpu=0
    shell:
        r"""
        echo "running plot_distribution for {wildcards.hist_name} ({wildcards.cut})"

        set +u

        source /cvmfs/sft.cern.ch/lcg/views/setupViews.sh LCG_107 x86_64-el9-gcc11-opt

        # Build cut flag: presence of -c means "apply cut"
        CUT_FLAG=""
        if [[ "{wildcards.cut}" == "cut" ]]; then
            CUT_FLAG="-c"
        fi

        python {input.script} -n {wildcards.hist_name} $CUT_FLAG

        mkdir -p {params.dest_dir}/{wildcards.hist_name}
        xrdcp ./plots/{wildcards.hist_name}/* {params.dest_dir}/{wildcards.hist_name}/
        """


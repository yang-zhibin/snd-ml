def get_metadata_from_output(output_path, target_name, output_type):
    """
    output_type: one of "model", "eval", or "matrix"
    """
    file_name = os.path.basename(output_path)
    pattern = rf"{output_type}_(.+?)_output"
    match = re.search(pattern, file_name)
    if match:
        m_name = match.group(1)
        ref_name = f"{output_type}_{m_name}_output_path"
        
        if (output_type in {"eval", "matrix"}) and target_name == "model_output":
            target_name = f"model_{m_name}_output_path"
        elif output_type == "matrix" and target_name == "eval_output":
            target_name = f"eval_{m_name}_output_path"

        #print(".",(output_path, target_name, output_type))
        return get_metadata_value(ref_name, output_path, target_name)
    else:
        print("Pattern not found.")

def get_metadata_from_model_output(model_output, target_name):
    file_name = os.path.basename(model_output)
    match = re.search(r"model_(.+?)_output", file_name)
    if match:
        m_name = match.group(1)
        #print("Extracted m_name:", m_name)
        ref_name = f"model_{m_name}_output_path"
    
        return get_metadata_value(ref_name, model_output, target_name)
    else:
        print("Pattern not found.")

def get_metadata_from_eval_output(eval_output, target_name):
    #print(eval_output, target_name)
    file_name = os.path.basename(eval_output)
    match = re.search(r"eval_(.+?)_output", file_name)
    if match:
        m_name = match.group(1)
        #print("Extracted m_name:", m_name)
        ref_name = f"eval_{m_name}_output_path"
        if target_name == "model_output":
            target_name = f"model_{m_name}_output_path"
        return get_metadata_value(ref_name, eval_output, target_name)
    else:
        print("Pattern not found.")

def get_metadata_value(ref_name, ref_value, target_name):
    #print((ref_name, ref_value, target_name))
    if METADATA is None:
       return ''
    return METADATA.loc[METADATA[ref_name] == ref_value, target_name].iloc[0]

def collect_target_paths(column_name):
    if METADATA is None:
       return ''

    if '3d' in column_name:
        # Filter out rows where 'split_3d_1' is 'train' or 'valid'
        filtered = METADATA[~METADATA['split_3d_1'].isin(['train', 'valid'])]
        return filtered[column_name].tolist()
    
    return METADATA[column_name].tolist()

def collect_model_path(target_name):
    with open("/afs/cern.ch/work/z/zhibin/snd-ml/snakemake/metadata/model_config.yaml", "r") as file:
        model_config = yaml.safe_load(file)
    

    model_name_list = []
    model_ckpt_list = []

    for model in model_config:
        for model_name, items in model.items():
            #print(model_name, paths)
            model_name_list.append(model_name)
            ckpt = None
            for item in items:
                if 'ckpt' in item:
                    ckpt = item['ckpt']
                    break
            model_ckpt_list.append(ckpt)

    if target_name=='ckpt':
        return model_ckpt_list
    elif target_name == 'model_output':
        target_paths = []
        for m in model_name_list:
            paths = collect_target_paths(f"model_{m}_output_path")
            target_paths.extend(paths)
        #print(target_paths)
        return target_paths
    elif target_name == 'eval_output':
        target_paths = []
        for m in model_name_list:
            paths = collect_target_paths(f"eval_{m}_output_path")
            target_paths.extend(paths)
        return target_paths
    elif target_name == 'matrix_output':
        target_paths = []
        for m in model_name_list:
            paths = collect_target_paths(f"matrix_{m}_output_path")
            target_paths.extend(paths)
        return target_paths

